{
  "name": "react-native-janus-mqtt-open-example",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-config": "~58.0.0",
    "@expo/metro-runtime": "~58.0.15",
    "@types/paho-mqtt": "^1.0.10",
    "events": "^3.3.0",
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "paho-mqtt": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "^155.0.1",
    "react-native-webrtc-web-shim": "^1.0.7"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/JanusMqttOpenExample.xcworkspace -UseNewBuildSystem=YES -scheme JanusMqttOpenExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web"
  },
  "private": true,
  "devDependencies": {
    "react-native-builder-bob": "^0.44.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
